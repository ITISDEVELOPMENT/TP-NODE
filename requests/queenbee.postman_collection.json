{
  "info": {
    "name": "Queen Bee API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }],
  "item": [
    {
      "name": "GET /health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "GET /api/hives",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/hives" }
    },
    {
      "name": "GET /api/hives?site_id=SN-CASA",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/hives?site_id=SN-CASA" }
    },
    {
      "name": "GET /api/hives/:id",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/hives/SN-CASA-001" }
    },
    {
      "name": "GET /api/hives/:id (404 ruche inconnue)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/hives/XX-NOPE-999" }
    },
    {
      "name": "POST /api/hives/:id/measures",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/hives/SN-CASA-001/measures",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hive_id\": \"SN-CASA-001\",\n  \"site_id\": \"SN-CASA\",\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"position_lat\": 12.5743,\n  \"position_lon\": -16.2873,\n  \"weight_kg\": 36.84,\n  \"temp_internal_c\": 34.4,\n  \"temp_external_c\": 27.1,\n  \"humidity_pct\": 64,\n  \"acoustic_activity_score\": 0.42,\n  \"battery_pct\": 88\n}"
        }
      }
    },
    {
      "name": "POST /api/hives/:id/measures (400 sans timestamp)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/hives/SN-CASA-001/measures",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"weight_kg\": 36.84\n}" }
      }
    },
    {
      "name": "POST /api/hives/:id/measures (404 ruche inconnue)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/hives/XX-NOPE-999/measures",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"timestamp\": \"2026-10-31T10:00:00Z\",\n  \"weight_kg\": 36.84\n}" }
      }
    }
  ]
}
